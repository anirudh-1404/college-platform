PORT=8080
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,https://vidyascope.com,https://api.vidyascope.com,https://onair.vidyascope.com,https://masteradmin.vidyascope.com
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Inquiry Email Notifications
STUDENT_NOTIFICATION_EMAIL=student@vidyascope.com
